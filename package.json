{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "qwik build",
		"build.client": "vp build",
		"build.preview": "vp build --ssr src/entry.preview.tsx",
		"build.server": "qwik check-client src dist && vp build -c adapters/vercel-edge/vite.config.ts",
		"build.types": "tsc --incremental --noEmit",
		"dev": "vp dev --mode ssr",
		"dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
		"preview": "qwik build preview && vp preview --open",
		"start": "vp dev --open --mode ssr",
		"qwik": "qwik",
		"up": "taze",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@builder.io/qwik": "catalog:dev",
		"@builder.io/qwik-city": "catalog:dev",
		"@iconify-json/carbon": "catalog:dev",
		"@types/node": "catalog:types",
		"ignore": "catalog:dev",
		"oxlint-plugin-qwik": "catalog:lint",
		"taze": "catalog:dev",
		"typescript": "catalog:types",
		"typescript-plugin-css-modules": "catalog:types",
		"unocss": "catalog:dev",
		"vercel": "catalog:build",
		"vite": "catalog:build",
		"vite-plus": "catalog:",
		"vite-tsconfig-paths": "catalog:build"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.2"
}
